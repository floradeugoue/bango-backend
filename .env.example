APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bango_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stockage des Médias (CR2 & RL)
MEDIA_DISK=public
MEDIA_TEMPORARY_URL_TTL=60
STREAM_PROVIDER=local

# Cloudflare R2 (Stockage distant compatible S3 pour production)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare Stream (Diffusion & Transcodage vidéo pour production)
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Module PAY (Paiements)
PAYMENT_ACTIVE_GATEWAY=monetbil
PAYMENT_DEFAULT_CURRENCY=XAF
PAYMENT_TIMEOUT_SECONDS=120
PAYMENT_MONETBIL_ENABLED=true
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
MONETBIL_API_URL=https://api.monetbil.com
MONETBIL_NOTIFY_URL=
PAYMENT_MONETBIL_FEE_TYPE=percentage_with_min
PAYMENT_MONETBIL_FEE_PERCENTAGE=2.0
PAYMENT_MONETBIL_MIN_FEE=100.0
